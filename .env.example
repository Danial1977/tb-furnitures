# TB FURNITURES — ENVIRONMENT CONFIGURATION (UK COMMERCE)

# 1. DATABASE
# For local PostgreSQL, or replace with your dedicated Neon / Supabase PostgreSQL URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tb_furnitures?schema=public"

# 2. NEXTAUTH & SECURITY
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="tb_furnitures_secret_jwt_key_2026_super_secure_random_token"

# 3. STRIPE PAYMENTS (TEST MODE)
# Set your Stripe test keys here:
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_key"

# 4. APP BRAND SETTINGS
NEXT_PUBLIC_APP_NAME="TB Furnitures"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="GBP"
NEXT_PUBLIC_COUNTRY="United Kingdom"

# 5. ADMIN BOOTSTRAP (For initial seed)
ADMIN_INITIAL_EMAIL="admin@tbfurnitures.co.uk"
ADMIN_INITIAL_PASSWORD="AdminPassword2026!"
